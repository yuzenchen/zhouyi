# Railway MongoDB 連線字串 (在 Railway dashboard → MongoDB service → Variables → MONGO_URL 取得)
MONGODB_URI=mongodb://mongo:PASSWORD@containers-us-west-xxx.railway.app:6543

# 資料庫名稱
MONGODB_DB=zhouyi

# n8n AI 解卦 webhook (沿用你原本的)
N8N_AI_WEBHOOK=https://n8n.ktch2.com/webhook/ai-analysis

# CORS 允許來源,用逗號分隔。
# 本地開發:* 即可
# 正式部署:列出 GitHub Pages 與其他正式來源,例如:
#   CORS_ORIGINS=https://yuzenchen.github.io,https://zhouyi.example.com
CORS_ORIGINS=*

# IP 地理位置查詢服務 (免費版每分鐘 45 次)
GEO_API_URL=http://ip-api.com/json/
